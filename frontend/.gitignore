# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules

# dist IS committed, deliberately. PythonAnywhere does not enable Node.js on
# every account, so the deployment uses the checked-in bundle when npm is
# unavailable. See deploy/setup.sh. Rebuild it with:
#     npm run build && git add -f dist
!dist
!dist/**

dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# render artefacts from tools/*.py and tools/*.mjs
.render/
